{% doc %}
  @prompt
    Create a simple custom footer section for my Aslam Beauty Shopify store.
    
    Desktop layout:
    - Keep the existing footer menu columns.
    - Replace the first menu column with a brand/contact column containing:
      - Aslam Beauty logo
      - Short editable brand description
      - Email
      - Phone number
    
    Keep the design minimal, clean and premium.
    
    Spacing must be highly customizable:
    - Desktop column gap
    - Mobile column gap
    - Desktop top/bottom padding
    - Mobile top/bottom padding and los left righ pading and spacing
    - Allow very tight spacing, including 0–1px where appropriate.
    
    All logo, text, email, phone, links and spacing settings must be editable from the Shopify Theme Editor.
    
    Keep the section responsive and do not affect the other footer functionality.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-brand-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-footer-brand__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-footer-brand__logo-{{ ai_gen_id }} {
    display: block;
    width: auto;
    max-width: 100%;
  }

  .ai-footer-brand__logo-{{ ai_gen_id }} img {
    display: block;
    height: {{ block.settings.logo_height }}px;
    width: auto;
    max-width: 100%;
  }

  .ai-footer-brand__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-footer-brand__contact-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.contact_gap }}px;
  }

  .ai-footer-brand__contact-item-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.contact_size }}px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-footer-brand__contact-item-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  .ai-footer-brand__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-brand__logo-{{ ai_gen_id }} img {
      height: {{ block.settings.logo_height_mobile }}px;
    }

    .ai-footer-brand__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }

    .ai-footer-brand__contact-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.contact_size_mobile }}px;
    }

    .ai-footer-brand__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
  }
{% endstyle %}

<footer-brand-{{ ai_gen_id }} class="ai-footer-brand-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-brand__container-{{ ai_gen_id }}">
    {% if block.settings.logo %}
      <a href="{{ routes.root_url }}" class="ai-footer-brand__logo-{{ ai_gen_id }}">
        <img
          src="{{ block.settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
          loading="lazy"
        >
      </a>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-footer-brand__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    <div class="ai-footer-brand__contact-{{ ai_gen_id }}">
      {% if block.settings.email != blank %}
        <a href="mailto:{{ block.settings.email }}" class="ai-footer-brand__contact-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <svg class="ai-footer-brand__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          {% endif %}
          <span>{{ block.settings.email }}</span>
        </a>
      {% endif %}

      {% if block.settings.phone != blank %}
        <a href="tel:{{ block.settings.phone }}" class="ai-footer-brand__contact-item-{{ ai_gen_id }}">
          {% if block.settings.show_icons %}
            <svg class="ai-footer-brand__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          {% endif %}
          <span>{{ block.settings.phone }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</footer-brand-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterBrand{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('footer-brand-{{ ai_gen_id }}', FooterBrand{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Footer brand column",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Desktop height",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Mobile height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Brand description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Premium beauty products for radiant skin</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Desktop size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Mobile size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "hello@aslambeauty.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "+92 300 1234567"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "range",
      "id": "contact_size",
      "label": "Desktop size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "contact_size_mobile",
      "label": "Mobile size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Desktop icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Mobile icon size",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text hover",
      "default": "#7b5ea7"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "contact_gap",
      "label": "Contact items gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Footer brand column"
    }
  ]
}
{% endschema %}
