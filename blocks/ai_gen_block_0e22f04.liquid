{% doc %}
  @prompt
    hero image and in bottom normal square size carrasoul of cards were we can select a blog post, a collection etc like default we can select and basic hero custmiztion like headin etc and we can enable and desable heading etc the carrasoul and design should be minimal modern, carrasoul should have bothe arrow and finger swip ability and responsive same on desctop and mobile  no layout shift error no hevy loading time simple minimal, It’s perfect. Keep the design and everything else exactly as it is. Just fix these two things:
    
    1. **Desktop arrows:**
       The carousel arrows are visible on desktop mode, but they are not working. Make sure the left and right arrows work properly and allow users to navigate through the carousel items.
    
    2. **Carousel column and card-size options:**
       Add customization options in the theme settings for:
    
       * How many columns/cards to show on **desktop**.
       * How many columns/cards to show on **mobile**.
       * Keep the current carousel card size as the **default** so the existing design remains unchanged.
       * Also add an option to adjust the **card size**, allowing users to make the cards smaller or larger as needed.
    
    Do not change anything else in the design, layout, spacing, styling, typography, or functionality. Keep everything exactly as it is except for these requested improvements.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__hero {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__hero img,
  .ai-editorial-carousel-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.hero_height }}px;
    object-fit: cover;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__placeholder {
    background: #f5f0fb;
    color: #6b6b6b;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: {{ block.settings.text_position }};
    justify-content: {{ block.settings.text_alignment }};
    padding: 7%;
    background: linear-gradient(90deg, rgba(0,0,0,.52), rgba(0,0,0,0));
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__content {
    max-width: 520px;
    text-align: {{ block.settings.text_align }};
    color: #ffffff;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__text {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__track-wrap {
    position: relative;
    padding: 28px 52px 4px;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - ({{ block.settings.desktop_columns | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.desktop_columns }});
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar { display: none; }

  .ai-editorial-carousel-{{ ai_gen_id }}__card {
    min-width: 0;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f0fb;
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__media img,
  .ai-editorial-carousel-{{ ai_gen_id }}__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__card-title {
    margin: 10px 0 0;
    font-family: {{ block.settings.heading_font.family }};
    font-size: 16px;
    line-height: 1.3;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__arrow {
    position: absolute;
    top: calc(50% - 18px);
    z-index: 2;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-editorial-carousel-{{ ai_gen_id }}__arrow--prev { left: 8px; }
  .ai-editorial-carousel-{{ ai_gen_id }}__arrow--next { right: 8px; }
  .ai-editorial-carousel-{{ ai_gen_id }}__arrow:disabled { opacity: .35; cursor: default; }

  @media screen and (max-width: 749px) {
    .ai-editorial-carousel-{{ ai_gen_id }}__hero,
    .ai-editorial-carousel-{{ ai_gen_id }}__hero img,
    .ai-editorial-carousel-{{ ai_gen_id }}__placeholder { min-height: {{ block.settings.mobile_hero_height }}px; }
    .ai-editorial-carousel-{{ ai_gen_id }}__heading { font-size: {{ block.settings.mobile_heading_size }}px; }
    .ai-editorial-carousel-{{ ai_gen_id }}__track { grid-auto-columns: calc((100% - ({{ block.settings.mobile_columns | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.mobile_columns }}); }
    .ai-editorial-carousel-{{ ai_gen_id }}__track-wrap { padding-right: 44px; padding-left: 44px; }
  }
{% endstyle %}

<editorial-carousel-{{ ai_gen_id }} class="ai-editorial-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.hero_image != blank %}
    <div class="ai-editorial-carousel-{{ ai_gen_id }}__hero">
      <img src="{{ block.settings.hero_image | image_url: width: 2000 }}" alt="{{ block.settings.hero_image.alt | escape }}" loading="eager" width="{{ block.settings.hero_image.width }}" height="{{ block.settings.hero_image.height }}">
      <div class="ai-editorial-carousel-{{ ai_gen_id }}__overlay"><div class="ai-editorial-carousel-{{ ai_gen_id }}__content">{% if block.settings.show_heading and block.settings.heading != blank %}<h2 class="ai-editorial-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.show_text and block.settings.text != blank %}<div class="ai-editorial-carousel-{{ ai_gen_id }}__text">{{ block.settings.text }}</div>{% endif %}</div></div>
    </div>
  {% else %}
    <div class="ai-editorial-carousel-{{ ai_gen_id }}__hero"><div class="ai-editorial-carousel-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div></div>
  {% endif %}

  {% if block.settings.show_carousel %}
    <div class="ai-editorial-carousel-{{ ai_gen_id }}__track-wrap">
      <button class="ai-editorial-carousel-{{ ai_gen_id }}__arrow ai-editorial-carousel-{{ ai_gen_id }}__arrow--prev" type="button" aria-label="Previous cards">&#8592;</button>
      <div class="ai-editorial-carousel-{{ ai_gen_id }}__track" data-track>
        {% for i in (1..4) %}
          {% liquid
            assign type_key = 'card_' | append: i | append: '_type'
            assign title_key = 'card_' | append: i | append: '_title'
            assign image_key = 'card_' | append: i | append: '_image'
            assign link_key = 'card_' | append: i | append: '_link'
            assign article_key = 'card_' | append: i | append: '_article'
            assign collection_key = 'card_' | append: i | append: '_collection'
            assign product_key = 'card_' | append: i | append: '_product'
            assign item_type = block.settings[type_key]
            assign title = block.settings[title_key]
            assign image = block.settings[image_key]
            assign link = block.settings[link_key]
            if item_type == 'article' and block.settings[article_key] != blank
              assign item = block.settings[article_key]
              assign title = item.title
              assign image = item.image
              assign link = item.url
            elsif item_type == 'collection' and block.settings[collection_key] != blank
              assign item = block.settings[collection_key]
              assign title = item.title
              assign image = item.featured_image
              assign link = item.url
            elsif item_type == 'product' and block.settings[product_key] != blank
              assign item = block.settings[product_key]
              assign title = item.title
              assign image = item.featured_image
              assign link = item.url
            endif
          %}
          {% if title != blank or image != blank %}<a class="ai-editorial-carousel-{{ ai_gen_id }}__card" href="{{ link | default: '#' }}"> <div class="ai-editorial-carousel-{{ ai_gen_id }}__media">{% if image != blank %}<img src="{{ image | image_url: width: 600 }}" alt="{{ title | escape }}" loading="lazy" width="600" height="600">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div>{% if title != blank %}<h3 class="ai-editorial-carousel-{{ ai_gen_id }}__card-title">{{ title }}</h3>{% endif %}</a>{% endif %}
        {% endfor %}
      </div>
      <button class="ai-editorial-carousel-{{ ai_gen_id }}__arrow ai-editorial-carousel-{{ ai_gen_id }}__arrow--next" type="button" aria-label="Next cards">&#8594;</button>
    </div>
  {% endif %}
</editorial-carousel-{{ ai_gen_id }}>

<script>
(function() {
  class EditorialCarousel{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      if (!this.track) return;
      this.prev = this.querySelector('.ai-editorial-carousel-{{ ai_gen_id }}__arrow--prev');
      this.next = this.querySelector('.ai-editorial-carousel-{{ ai_gen_id }}__arrow--next');
      this.prev.addEventListener('click', () => this.move(-1));
      this.next.addEventListener('click', () => this.move(1));
      this.update = () => { const end = this.track.scrollWidth - this.track.clientWidth - 2; this.prev.disabled = this.track.scrollLeft <= 2; this.next.disabled = this.track.scrollLeft >= end; };
      this.track.addEventListener('scroll', this.update, { passive: true });
      window.addEventListener('resize', this.update);
      this.update();
    }
    move(direction) { this.track.scrollBy({ left: direction * this.track.clientWidth * 0.85, behavior: 'smooth' }); }
  }
  customElements.define('editorial-carousel-{{ ai_gen_id }}', EditorialCarousel{{ ai_gen_id }});
})();
</script>

