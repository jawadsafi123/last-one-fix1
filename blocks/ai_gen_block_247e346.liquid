{% doc %}
  @prompt
    Create a product page block for Aslam Beauty that displays per-product highlight labels from metafields in a beautiful horizontal strip. METAFIELD SOURCE: Read from product.metafields.custom.highlight_1, highlight_2, highlight_3, highlight_4. If a metafield is blank, skip that item entirely - no empty gap, no placeholder. If ALL 4 are empty, hide entire block completely with zero height. Never show errors or blank slots. LAYOUT: Single horizontal row of only filled items. Items separated by subtle vertical dividers only between filled items, not at edges. Each item: fixed SVG sparkle icon on top, label text below. Desktop: evenly spaced one row. Mobile: horizontally scrollable with snap, hidden scrollbar, no wrapping. STYLE: Background gradient from #ede5f5 (lavender) to #f5f0fb (near white) left to right. Border-radius 50px pill shape. Icons #f5a623 golden amber 22px inline SVG sparkle. Label text #1a1a2e 12px Inter centered. Dividers 1px solid rgba(91,63,140,0.15). Padding 12px top-bottom 16px left-right per item. No box shadow. Zero margin impact on surrounding blocks. THEME EDITOR SETTINGS: icon color (default #f5a623), gradient start color (default #ede5f5), gradient end color (default #f5f0fb), padding top/bottom, pill border-radius toggle. CRITICAL: Completely isolated, no effect on Add to Cart, variants, price, or any other block. No Liquid errors under any condition. No broken layout with 1, 2, 3, or 4 metafields filled. When all empty: renders nothing, zero height, invisible. No external libraries. Clean valid Liquid HTML CSS only., Fix and refine an existing product highlight strip block. Read metafields using these exact keys with NO underscore: product.metafields.custom.highlight1, product.metafields.custom.highlight2, product.metafields.custom.highlight3, product.metafields.custom.highlight4. If a metafield value is blank or nil, skip that item with no gap. If all 4 are empty, render nothing at all, zero height, completely invisible. Layout: single horizontal row of filled items only, separated by subtle vertical dividers only between items. Each item has a small inline SVG sparkle icon in golden amber #f5a623 at 22px, and label text below in #1a1a2e at 12px Inter font centered. Background: linear gradient left to right from #ede5f5 to #f5f0fb. Border-radius 50px pill shape. Padding 12px top bottom, 16px left right per item. Dividers 1px solid rgba(91,63,140,0.15). Mobile: horizontal scroll with snap, hidden scrollbar, no wrapping. Desktop: evenly spaced one row. No box shadow. No external libraries. No Liquid errors under any condition. Completely isolated from all other product page blocks., Refine this section without changing its overall design.
    
    Desktop: Make all 4 highlight cards fit properly in one row. Center the icon and text perfectly, and fix the card/border sizing so no letters or words are clipped or hidden.
    Icons: Use 4 different universal icons (e.g. heart, star, sparkle, shield). The same icon stays assigned to the same highlight position across every product—only the metafield text changes.
    Mobile: Make the layout fully responsive. Show all available highlights in one row within the viewport: 4 highlights = 4 visible, 3 = 3 visible, 2 = 2 visible, 1 = 1 visible. Do not use horizontal scrolling. Reduce padding/gaps as needed while keeping everything clean and readable.
    Keep the section clean, balanced, and centered on both desktop and mobile. while keeping the functionality as it as
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign highlight1 = product.metafields.custom.highlight1
  assign highlight2 = product.metafields.custom.highlight2
  assign highlight3 = product.metafields.custom.highlight3
  assign highlight4 = product.metafields.custom.highlight4

  assign highlights = ''
  assign highlight_count = 0

  if highlight1 != blank
    assign highlights = highlights | append: '1::' | append: highlight1 | append: '||'
    assign highlight_count = highlight_count | plus: 1
  endif

  if highlight2 != blank
    assign highlights = highlights | append: '2::' | append: highlight2 | append: '||'
    assign highlight_count = highlight_count | plus: 1
  endif

  if highlight3 != blank
    assign highlights = highlights | append: '3::' | append: highlight3 | append: '||'
    assign highlight_count = highlight_count | plus: 1
  endif

  if highlight4 != blank
    assign highlights = highlights | append: '4::' | append: highlight4 | append: '||'
    assign highlight_count = highlight_count | plus: 1
  endif

  assign highlights_array = highlights | split: '||'
%}

{% if highlight_count > 0 %}
  {% style %}
    .ai-highlight-strip-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .ai-highlight-strip-container-{{ ai_gen_id }} {
      background: linear-gradient(to right, {{ block.settings.gradient_start_color }}, {{ block.settings.gradient_end_color }});
      {% if block.settings.enable_pill_shape %}
        border-radius: 50px;
      {% else %}
        border-radius: {{ block.settings.border_radius }}px;
      {% endif %}
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      overflow: visible;
    }

    .ai-highlight-strip-wrapper-{{ ai_gen_id }} {
      display: flex;
      align-items: stretch;
      justify-content: center;
      gap: 0;
      width: 100%;
    }

    .ai-highlight-item-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 8px {{ block.settings.item_padding }}px;
      flex: 1;
      min-width: 0;
    }

    .ai-highlight-item-{{ ai_gen_id }}:not(:last-child) {
      border-right: 1px solid rgba(91, 63, 140, 0.15);
    }

    .ai-highlight-icon-{{ ai_gen_id }} {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ai-highlight-icon-{{ ai_gen_id }} svg {
      width: 100%;
      height: 100%;
      fill: {{ block.settings.icon_color }};
    }

    .ai-highlight-label-{{ ai_gen_id }} {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      color: #1a1a2e;
      text-align: center;
      margin: 0;
      word-wrap: break-word;
      overflow-wrap: break-word;
      hyphens: auto;
      max-width: 100%;
    }

    @media screen and (max-width: 749px) {
      .ai-highlight-strip-container-{{ ai_gen_id }} {
        padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
      }

      .ai-highlight-item-{{ ai_gen_id }} {
        padding: 6px {{ block.settings.item_padding | times: 0.6 }}px;
        gap: 6px;
      }

      .ai-highlight-icon-{{ ai_gen_id }} {
        width: 18px;
        height: 18px;
      }

      .ai-highlight-label-{{ ai_gen_id }} {
        font-size: 10px;
        line-height: 1.3;
      }
    }

    @media screen and (max-width: 480px) {
      .ai-highlight-strip-container-{{ ai_gen_id }} {
        padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.5 }}px;
      }

      .ai-highlight-item-{{ ai_gen_id }} {
        padding: 4px {{ block.settings.item_padding | times: 0.4 }}px;
        gap: 4px;
      }

      .ai-highlight-icon-{{ ai_gen_id }} {
        width: 16px;
        height: 16px;
      }

      .ai-highlight-label-{{ ai_gen_id }} {
        font-size: 9px;
      }
    }
  {% endstyle %}

  <div class="ai-highlight-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-highlight-strip-container-{{ ai_gen_id }}">
      <div class="ai-highlight-strip-wrapper-{{ ai_gen_id }}">
        {% for highlight_data in highlights_array %}
          {% if highlight_data != blank %}
            {% assign parts = highlight_data | split: '::' %}
            {% assign position = parts[0] %}
            {% assign highlight_text = parts[1] %}
            
            <div class="ai-highlight-item-{{ ai_gen_id }}">
              <div class="ai-highlight-icon-{{ ai_gen_id }}">
                {% if position == '1' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                {% elsif position == '2' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                {% elsif position == '3' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
                    <path d="M19 3L19.5 5L21.5 5.5L19.5 6L19 8L18.5 6L16.5 5.5L18.5 5L19 3Z"/>
                  </svg>
                {% elsif position == '4' %}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                  </svg>
                {% endif %}
              </div>
              <p class="ai-highlight-label-{{ ai_gen_id }}">{{ highlight_text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Product highlights",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Metafield source"
    },
    {
      "type": "paragraph",
      "content": "This block reads from product.metafields.custom.highlight1, highlight2, highlight3, and highlight4. Empty metafields are automatically skipped."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#f5a623"
    },
    {
      "type": "color",
      "id": "gradient_start_color",
      "label": "Gradient start",
      "default": "#ede5f5"
    },
    {
      "type": "color",
      "id": "gradient_end_color",
      "label": "Gradient end",
      "default": "#f5f0fb"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding top/bottom",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding left/right",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Border style"
    },
    {
      "type": "checkbox",
      "id": "enable_pill_shape",
      "label": "Enable pill shape",
      "default": true
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Product highlights"
    }
  ]
}
{% endschema %}
