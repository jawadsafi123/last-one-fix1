<script>
  (function() {
    class OrderTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.progressLine = null;
        this.ship = null;
        this.icons = [];
        this.observer = null;
        this.animationDuration = parseFloat(this.dataset.animationDuration) || 3;
        this.hasAnimated = false;
        this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      connectedCallback() {
        this.progressLine = this.querySelector('.ai-order-timeline-line-progress-{{ ai_gen_id }}');
        this.ship = this.querySelector('.ai-order-timeline-ship-{{ ai_gen_id }}');
        this.icons = [
          this.querySelector('.ai-order-timeline-icon-1-{{ ai_gen_id }}'),
          this.querySelector('.ai-order-timeline-icon-2-{{ ai_gen_id }}'),
          this.querySelector('.ai-order-timeline-icon-3-{{ ai_gen_id }}')
        ];
        
        if (!this.progressLine || !this.ship) return;

        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.3
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.startAnimation();
            } else {
              this.resetAnimation();
            }
          });
        }, options);

        this.observer.observe(this);
      }

      startAnimation() {
        if (this.prefersReducedMotion) {
          this.progressLine.style.width = '100%';
          this.ship.style.left = '100%';
          this.icons.forEach(icon => {
            if (icon) icon.classList.add('completed');
          });
          return;
        }

        requestAnimationFrame(() => {
          this.progressLine.style.width = '100%';
          this.ship.style.left = '100%';
          
          const duration = this.animationDuration * 1000;
          const icon1Time = duration * 0;
          const icon2Time = duration * 0.5;
          const icon3Time = duration * 1;

          if (this.icons[0]) {
            setTimeout(() => {
              this.icons[0].classList.add('completed');
            }, icon1Time);
          }

          if (this.icons[1]) {
            setTimeout(() => {
              this.icons[1].classList.add('completed');
            }, icon2Time);
          }

          if (this.icons[2]) {
            setTimeout(() => {
              this.icons[2].classList.add('completed');
            }, icon3Time);
          }
        });
      }

      resetAnimation() {
        if (this.prefersReducedMotion) {
          this.progressLine.style.width = '0%';
          this.ship.style.left = '0%';
          this.icons.forEach(icon => {
            if (icon) icon.classList.remove('completed');
          });
          return;
        }

        this.progressLine.style.width = '0%';
        this.ship.style.left = '0%';
        this.icons.forEach(icon => {
          if (icon) icon.classList.remove('completed');
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('order-timeline-{{ ai_gen_id }}', OrderTimeline{{ ai_gen_id }});
  })();
</script>

