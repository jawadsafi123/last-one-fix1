{% doc %}
  @prompt
    Create a modern announcement bar section with: marquee/scrolling toggle, arrow navigation, auto-scroll with speed control, social media icons (Instagram, Facebook, TikTok, Pinterest) with URL inputs, prefix icons per announcement (sparkle, star, diamond, heart), bg color, text color, top/bottom padding, font size, and multiple announcement blocks. Lightweight, self-contained, no interference with other sections., its perfect but the anouncment bar is i dont khno its acting like page because the the left and right edge is white its not fully touching the edges like default one fix it, the left is now touch but not the right one
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
  }

  .ai-announcement-bar__nav-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .ai-announcement-bar__nav-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-bar__nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-announcement-bar__content-wrapper-{{ ai_gen_id }} {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }}.marquee {
    animation: ai-announcement-marquee-{{ ai_gen_id }} var(--marquee-duration) linear infinite;
    width: max-content;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }}.marquee .ai-announcement-bar__item-{{ ai_gen_id }} {
    display: inline-flex;
  }

  .ai-announcement-bar__item-{{ ai_gen_id }} {
    display: none;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .ai-announcement-bar__item-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-announcement-bar__content-{{ ai_gen_id }}.marquee .ai-announcement-bar__item-{{ ai_gen_id }} {
    display: inline-flex;
  }

  .ai-announcement-bar__icon-{{ ai_gen_id }} {
    width: {{ block.settings.font_size }}px;
    height: {{ block.settings.font_size }}px;
    flex-shrink: 0;
  }

  .ai-announcement-bar__social-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-announcement-bar__social-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .ai-announcement-bar__social-link-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-bar__social-link-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  @keyframes ai-announcement-marquee-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__nav-{{ ai_gen_id }} {
      display: none;
    }
    
    .ai-announcement-bar__social-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-announcement-bar__container-{{ ai_gen_id }} {
      padding: 0 8px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  data-marquee="{{ block.settings.enable_marquee }}"
  data-auto-scroll="{{ block.settings.enable_auto_scroll }}"
  data-scroll-speed="{{ block.settings.scroll_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar__container-{{ ai_gen_id }}">
    {% if block.settings.show_arrows %}
      <button
        class="ai-announcement-bar__nav-{{ ai_gen_id }} ai-announcement-bar__nav-prev-{{ ai_gen_id }}"
        aria-label="Previous announcement"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
    {% endif %}

    <div class="ai-announcement-bar__content-wrapper-{{ ai_gen_id }}">
      <div class="ai-announcement-bar__content-{{ ai_gen_id }}">
        {% assign announcements = '' %}
        {% if block.settings.announcement_1_text != blank %}
          {% assign announcements = announcements | append: '1,' %}
        {% endif %}
        {% if block.settings.announcement_2_text != blank %}
          {% assign announcements = announcements | append: '2,' %}
        {% endif %}
        {% if block.settings.announcement_3_text != blank %}
          {% assign announcements = announcements | append: '3,' %}
        {% endif %}
        {% if block.settings.announcement_4_text != blank %}
          {% assign announcements = announcements | append: '4,' %}
        {% endif %}
        {% if block.settings.announcement_5_text != blank %}
          {% assign announcements = announcements | append: '5,' %}
        {% endif %}

        {% assign announcement_array = announcements | split: ',' %}
        
        {% for num in announcement_array %}
          {% if num != blank %}
            {% assign text_key = 'announcement_' | append: num | append: '_text' %}
            {% assign icon_key = 'announcement_' | append: num | append: '_icon' %}
            {% assign text = block.settings[text_key] %}
            {% assign icon = block.settings[icon_key] %}
            
            <div class="ai-announcement-bar__item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
              {% if icon != 'none' %}
                <span class="ai-announcement-bar__icon-{{ ai_gen_id }}">
                  {% case icon %}
                    {% when 'sparkle' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 0L14.59 8.41L23 11L14.59 13.59L12 22L9.41 13.59L1 11L9.41 8.41L12 0Z"/>
                      </svg>
                    {% when 'star' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    {% when 'diamond' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L2 9L12 22L22 9L12 2Z"/>
                      </svg>
                    {% when 'heart' %}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      </svg>
                  {% endcase %}
                </span>
              {% endif %}
              <span>{{ text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-announcement-bar__nav-{{ ai_gen_id }} ai-announcement-bar__nav-next-{{ ai_gen_id }}"
        aria-label="Next announcement"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_social_icons %}
      <div class="ai-announcement-bar__social-{{ ai_gen_id }}">
        {% if block.settings.instagram_url != blank %}
          <a
            href="{{ block.settings.instagram_url }}"
            class="ai-announcement-bar__social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.facebook_url != blank %}
          <a
            href="{{ block.settings.facebook_url }}"
            class="ai-announcement-bar__social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.tiktok_url != blank %}
          <a
            href="{{ block.settings.tiktok_url }}"
            class="ai-announcement-bar__social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.pinterest_url != blank %}
          <a
            href="{{ block.settings.pinterest_url }}"
            class="ai-announcement-bar__social-link-{{ ai_gen_id }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Pinterest"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0a12 12 0 0 0-4.37 23.17c-.05-.95-.1-2.42.02-3.46.1-.94.67-2.84.67-2.84s-.17-.34-.17-.84c0-.79.46-1.38 1.03-1.38.49 0 .72.37.72.81 0 .49-.31 1.23-.47 1.91-.13.56.28 1.02.83 1.02.99 0 1.76-1.05 1.76-2.55 0-1.33-.96-2.26-2.33-2.26-1.59 0-2.52 1.19-2.52 2.42 0 .48.18.99.41 1.27.04.05.05.1.04.15-.04.18-.14.56-.16.64-.02.11-.08.13-.19.08-.7-.33-1.14-1.35-1.14-2.18 0-1.76 1.28-3.38 3.69-3.38 1.94 0 3.45 1.38 3.45 3.23 0 1.93-1.21 3.48-2.9 3.48-.57 0-1.1-.29-1.28-.64 0 0-.28 1.07-.35 1.33-.13.51-.48 1.15-.71 1.54a12 12 0 1 0 7.74-22.3z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoScrollInterval = null;
        this.isMarquee = this.dataset.marquee === 'true';
        this.autoScroll = this.dataset.autoScroll === 'true';
        this.scrollSpeed = parseInt(this.dataset.scrollSpeed) || 5;
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-announcement-bar__item-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-announcement-bar__content-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-announcement-bar__nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-announcement-bar__nav-next-{{ ai_gen_id }}');

        if (this.items.length === 0) return;

        if (this.isMarquee) {
          this.setupMarquee();
        } else {
          this.setupSlider();
        }
      }

      setupMarquee() {
        this.content.classList.add('marquee');
        
        const contentClone = this.content.innerHTML;
        this.content.innerHTML = contentClone + contentClone;

        const totalWidth = this.content.scrollWidth / 2;
        const duration = totalWidth / this.scrollSpeed;
        this.content.style.setProperty('--marquee-duration', duration + 's');

        if (this.prevButton) this.prevButton.style.display = 'none';
        if (this.nextButton) this.nextButton.style.display = 'none';
      }

      setupSlider() {
        this.showItem(0);

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate(-1));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate(1));
        }

        if (this.autoScroll && this.items.length > 1) {
          this.startAutoScroll();
          
          this.addEventListener('mouseenter', () => this.stopAutoScroll());
          this.addEventListener('mouseleave', () => this.startAutoScroll());
        }
      }

      showItem(index) {
        this.items.forEach((item, i) => {
          if (i === index) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
        this.currentIndex = index;
      }

      navigate(direction) {
        let newIndex = this.currentIndex + direction;
        
        if (newIndex < 0) {
          newIndex = this.items.length - 1;
        } else if (newIndex >= this.items.length) {
          newIndex = 0;
        }
        
        this.showItem(newIndex);
      }

      startAutoScroll() {
        this.stopAutoScroll();
        this.autoScrollInterval = setInterval(() => {
          this.navigate(1);
        }, 5000);
      }

      stopAutoScroll() {
        if (this.autoScrollInterval) {
          clearInterval(this.autoScrollInterval);
          this.autoScrollInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoScroll();
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

