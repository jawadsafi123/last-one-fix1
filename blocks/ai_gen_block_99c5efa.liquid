{% doc %}
  @prompt
    generate order on whatsapp button highly customizable, its perfect keep it as it as jus add the bottom and up paading to make it near or far to other section becaus i dont really a lover of free gap and spacing, make the spacing up and down 2px
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-order-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.margin_top }}px;
    padding-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-whatsapp-order-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.border_width > 0 %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
    gap: {{ block.settings.icon_text_gap }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .ai-whatsapp-order-container-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    {% if block.settings.border_width > 0 %}
      border-color: {{ block.settings.hover_border_color }};
    {% endif %}
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-whatsapp-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-whatsapp-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
    transition: fill 0.3s ease;
  }

  .ai-whatsapp-order-container-{{ ai_gen_id }}:hover .ai-whatsapp-icon-{{ ai_gen_id }} svg {
    fill: {{ block.settings.hover_icon_color }};
  }

  .ai-whatsapp-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    text-transform: {{ block.settings.text_transform }};
    transition: color 0.3s ease;
  }

  .ai-whatsapp-order-container-{{ ai_gen_id }}:hover .ai-whatsapp-text-{{ ai_gen_id }} {
    color: {{ block.settings.hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-order-{{ ai_gen_id }} {
      width: 100%;
      padding-top: {{ block.settings.mobile_margin_top }}px;
      padding-bottom: {{ block.settings.mobile_margin_bottom }}px;
    }

    .ai-whatsapp-order-container-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-whatsapp-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-whatsapp-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<whatsapp-order-button-{{ ai_gen_id }} class="ai-whatsapp-order-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% liquid
    assign phone = block.settings.phone_number | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
    
    if product
      assign product_title = product.title
      assign product_url = shop.url | append: product.url
      assign product_price = product.price | money
      
      if product.selected_or_first_available_variant
        assign variant_title = product.selected_or_first_available_variant.title
      else
        assign variant_title = ''
      endif
    else
      assign product_title = ''
      assign product_url = ''
      assign product_price = ''
      assign variant_title = ''
    endif

    assign custom_message = block.settings.custom_message
    
    if block.settings.include_product_info and product
      if variant_title != 'Default Title' and variant_title != ''
        assign message = 'Hi, I want to order: ' | append: product_title | append: ' (' | append: variant_title | append: ') - ' | append: product_price | append: '. Link: ' | append: product_url
      else
        assign message = 'Hi, I want to order: ' | append: product_title | append: ' - ' | append: product_price | append: '. Link: ' | append: product_url
      endif
      
      if custom_message != blank
        assign message = custom_message | append: ' ' | append: message
      endif
    elsif custom_message != blank
      assign message = custom_message
    else
      assign message = 'Hi, I would like to place an order.'
    endif

    assign encoded_message = message | url_encode
    assign whatsapp_url = 'https://wa.me/' | append: phone | append: '?text=' | append: encoded_message
  %}

  <a
    href="{{ whatsapp_url }}"
    class="ai-whatsapp-order-container-{{ ai_gen_id }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ block.settings.button_text }}"
  >
    {% if block.settings.show_icon %}
      <div class="ai-whatsapp-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </div>
    {% endif %}
    <span class="ai-whatsapp-text-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
  </a>
</whatsapp-order-button-{{ ai_gen_id }}>

<script>
  (function() {
    class WhatsAppOrderButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-whatsapp-order-container-{{ ai_gen_id }}');
        
        if (this.button) {
          this.button.addEventListener('click', this.handleClick.bind(this));
        }
      }

      handleClick(event) {
        {% if block.settings.track_analytics %}
          if (typeof gtag !== 'undefined') {
            gtag('event', 'whatsapp_order_click', {
              'event_category': 'engagement',
              'event_label': '{{ block.settings.button_text }}',
              'value': 1
            });
          }
        {% endif %}
      }

      disconnectedCallback() {
        if (this.button) {
          this.button.removeEventListener('click', this.handleClick);
        }
      }
    }

    customElements.define('whatsapp-order-button-{{ ai_gen_id }}', WhatsAppOrderButton{{ ai_gen_id }});
  })();
</script>

