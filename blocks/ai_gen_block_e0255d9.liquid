      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "tagline_size_mobile",
      "label": "Mobile size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "tagline_line_height",
      "label": "Line height",
      "options": [
        {
          "value": "1",
          "label": "Tight"
        },
        {
          "value": "1.4",
          "label": "Normal"
        },
        {
          "value": "1.6",
          "label": "Loose"
        }
      ],
      "default": "1.4"
    },
    {
      "type": "select",
      "id": "tagline_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Color",
      "default": "#7b5ea7"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description_text",
      "label": "Description text",
      "default": "<p>Discover premium skincare crafted with natural ingredients for radiant, healthy skin.</p>"
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "Max width",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "label": "Desktop size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Mobile size",
      "min": 12,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "description_line_height",
      "label": "Line height",
      "options": [
        {
