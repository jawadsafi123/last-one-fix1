<div class="announcement-countdown" {{ block.shopify_attributes }} data-announcement-countdown data-end-time="{{ block.settings.end_date | date: '%s' }}" data-expired-text="{{ block.settings.expired_text | escape }}" role="timer" aria-live="off" style="--countdown-bg: {{ block.settings.background_color }}; --countdown-text: {{ block.settings.text_color }};">
  {% if block.settings.label != blank %}
    <span class="announcement-countdown__label">{{ block.settings.label | escape }}</span>
  {% endif %}
  <span class="announcement-countdown__units" data-countdown-units>
    <span class="announcement-countdown__unit"><strong data-days>00</strong><small>Days</small></span>
    <span class="announcement-countdown__separator">:</span>
    <span class="announcement-countdown__unit"><strong data-hours>00</strong><small>Hrs</small></span>
    <span class="announcement-countdown__separator">:</span>
    <span class="announcement-countdown__unit"><strong data-minutes>00</strong><small>Min</small></span>
    <span class="announcement-countdown__separator">:</span>
    <span class="announcement-countdown__unit"><strong data-seconds>00</strong><small>Sec</small></span>
  </span>
</div>

<script>
  (() => {
    const script = document.currentScript;
    const countdown = script?.previousElementSibling;
    if (!countdown || countdown.dataset.initialized === 'true') return;
    countdown.dataset.initialized = 'true';

    const endTime = Number(countdown.dataset.endTime) * 1000;
    const days = countdown.querySelector('[data-days]');
    const hours = countdown.querySelector('[data-hours]');
    const minutes = countdown.querySelector('[data-minutes]');
    const seconds = countdown.querySelector('[data-seconds]');
    const units = countdown.querySelector('[data-countdown-units]');
    let timer;

    const pad = (value) => String(value).padStart(2, '0');

    const update = () => {
      const remaining = Math.max(0, endTime - Date.now());
      const total = Math.floor(remaining / 1000);

      if (remaining <= 0) {
        if (units) units.textContent = countdown.dataset.expiredText || 'Offer ended';
        clearInterval(timer);
        return;
      }

      days.textContent = pad(Math.floor(total / 86400));
      hours.textContent = pad(Math.floor((total % 86400) / 3600));
      minutes.textContent = pad(Math.floor((total % 3600) / 60));
      seconds.textContent = pad(total % 60);
    };

    update();
    timer = setInterval(update, 1000);
  })();
</script>

{% stylesheet %}
  .announcement-countdown {
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--countdown-bg);
    color: var(--countdown-text);
    line-height: 1;
    white-space: nowrap;
  }

  .announcement-countdown__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .announcement-countdown__units {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .announcement-countdown__unit {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
  }

  .announcement-countdown__unit strong {
    font-variant-numeric: tabular-nums;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .announcement-countdown__unit small {
    font-size: 0.52rem;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .announcement-countdown__separator {
    opacity: 0.45;
    font-size: 0.68rem;
  }

  @media screen and (max-width: 749px) {
    .announcement-countdown {
      gap: 7px;
      padding: 4px 8px;
    }

    .announcement-countdown__label {
      font-size: 0.68rem;
    }

    .announcement-countdown__unit strong {
      font-size: 0.72rem;
    }

    .announcement-countdown__unit small {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Limited-time offer ends in"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date and time",
      "info": "Use ISO format, for example 2026-10-03T08:00:00+00:00."
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "Expired text",
      "default": "Offer ended"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1A1A2E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Countdown timer"
    }
  ]
}
{% endschema %}
