{% style %}
  #shopify-section-{{ section.id }} .blog-category-tabs {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 20px;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__heading {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 32px;
    font-weight: 500;
    color: #1a1a2e;
    margin: 0 0 24px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__tablist {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    border-bottom: 1px solid #dfdfdf;
    margin-bottom: 28px;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__tablist::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__tab {
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #6b6b6b;
    padding: 12px 16px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__tab:hover {
    color: #7b5ea7;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__tab.is-active {
    color: #7b5ea7;
    border-bottom-color: #7b5ea7;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__panel[hidden] {
    display: none;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__empty {
    font-family: 'Inter', sans-serif;
    color: #6b6b6b;
    text-align: center;
    padding: 32px 0;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__row-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: 0;
    padding: 4px 0 12px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__row::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card {
    flex: 0 0 260px;
    scroll-snap-align: start;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: #f5f0fb;
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card-image--placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #ede5f5, #f5f0fb);
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 17px;
    font-weight: 500;
    color: #1a1a2e;
    margin: 0 0 6px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card-date {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #6b6b6b;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__card--viewall {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__viewall-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    border: 1px solid #7b5ea7;
    color: #7b5ea7;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 15px;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__viewall-link:hover {
    background: #f5f0fb;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__arrow {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 100px;
    border: 1px solid #7b5ea7;
    background: #ffffff;
    color: #7b5ea7;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .blog-category-tabs__arrow:hover {
    background: #f5f0fb;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .blog-category-tabs__card {
      flex: 0 0 200px;
    }
    #shopify-section-{{ section.id }} .blog-category-tabs__heading {
      font-size: 26px;
    }
    #shopify-section-{{ section.id }} .blog-category-tabs__arrow {
      display: none;
    }
  }
{% endstyle %}

<div class="blog-category-tabs" data-blog-category-tabs>
  {%- if section.settings.heading != blank -%}
    <h2 class="blog-category-tabs__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- assign visible_blocks = '' -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.blog != blank -%}
      {%- assign visible_blocks = visible_blocks | append: block.id | append: ',' -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="blog-category-tabs__tablist" role="tablist" aria-label="{{ section.settings.heading | default: 'Blog categories' }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign blog = block.settings.blog
        if blog == blank
          continue
        endif
        assign label = block.settings.label | default: blog.title
      -%}
      <button
        type="button"
        class="blog-category-tabs__tab{% if forloop.first %} is-active{% endif %}"
        role="tab"
        id="tab-{{ section.id }}-{{ block.id }}"
        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        aria-controls="panel-{{ section.id }}-{{ block.id }}"
        data-tab-target="{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {{ label }}
      </button>
    {%- endfor -%}
  </div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign blog = block.settings.blog
      if blog == blank
        continue
      endif
      assign limit = section.settings.posts_to_show
    -%}
    <div
      class="blog-category-tabs__panel{% if forloop.first %} is-active{% endif %}"
      id="panel-{{ section.id }}-{{ block.id }}"
      role="tabpanel"
      aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
      data-tab-panel="{{ block.id }}"
      {% unless forloop.first %}hidden{% endunless %}
    >
      {%- if blog.articles_count == 0 -%}
        <p class="blog-category-tabs__empty">No posts yet in this category.</p>
      {%- else -%}
        <div class="blog-category-tabs__row-wrap">
          {%- if section.settings.show_arrows -%}
            <button type="button" class="blog-category-tabs__arrow blog-category-tabs__arrow--prev" data-scroll-prev aria-label="Scroll left">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}

          <ul class="blog-category-tabs__row" data-scroll-row>
            {%- for article in blog.articles limit: limit -%}
              <li class="blog-category-tabs__card">
                <a href="{{ article.url }}" class="blog-category-tabs__card-link">
                  <div class="blog-category-tabs__card-image">
                    {%- if article.image -%}
                      <img
                        src="{{ article.image | image_url: width: 400 }}"
                        alt="{{ article.image.alt | default: article.title | escape }}"
                        loading="lazy"
                        width="400"
                        height="400"
                      >
                    {%- else -%}
                      <div class="blog-category-tabs__card-image--placeholder"></div>
                    {%- endif -%}
                  </div>
                  <div class="blog-category-tabs__card-body">
                    <p class="blog-category-tabs__card-title">{{ article.title }}</p>
                    <p class="blog-category-tabs__card-date">{{ article.published_at | date: '%B %d, %Y' }}</p>
                  </div>
                </a>
              </li>
            {%- endfor -%}

            {%- if blog.articles_count > limit -%}
              <li class="blog-category-tabs__card blog-category-tabs__card--viewall">
                <a href="{{ blog.url }}" class="blog-category-tabs__viewall-link">
                  <span>View all</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            {%- endif -%}
          </ul>

          {%- if section.settings.show_arrows -%}
            <button type="button" class="blog-category-tabs__arrow blog-category-tabs__arrow--next" data-scroll-next aria-label="Scroll right">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

<script>
(function () {
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.hasAttribute('data-blog-category-tabs')) {
    root = document.querySelector('[data-blog-category-tabs]');
  }
  if (!root) return;

  var tabs = root.querySelectorAll('[data-tab-target]');
  var panels = root.querySelectorAll('[data-tab-panel]');

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var target = tab.getAttribute('data-tab-target');

      tabs.forEach(function (t) {
        var active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach(function (panel) {
        var active = panel.getAttribute('data-tab-panel') === target;
        panel.classList.toggle('is-active', active);
        if (active) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    });
  });

  root.querySelectorAll('[data-scroll-row]').forEach(function (row) {
    var wrap = row.closest('.blog-category-tabs__row-wrap');
    if (!wrap) return;
    var prevBtn = wrap.querySelector('[data-scroll-prev]');
    var nextBtn = wrap.querySelector('[data-scroll-next]');
    var scrollAmount = function () {
      var card = row.querySelector('.blog-category-tabs__card');
      return card ? card.offsetWidth + 16 : 300;
    };
    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        row.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        row.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Blog Category Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Posts to show per category",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show scroll arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab label (optional)",
          "info": "Leave blank to use the blog's own title"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Blog Category Tabs",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
