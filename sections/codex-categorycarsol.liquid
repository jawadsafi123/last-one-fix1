{% liquid
  assign category_count = section.blocks.size
  assign carousel_label = section.settings.carousel_label | default: section.settings.title | default: 'Shop by category'
%}

<section
  id="AslamShopByCategory-{{ section.id }}"
  class="aslam-shop-by-category"
  style="--asbc-background: {{ section.settings.background_color }}; --asbc-text: {{ section.settings.text_color }}; --asbc-bubble-background: {{ section.settings.bubble_background }}; --asbc-bubble-size: {{ section.settings.bubble_size }}px; --asbc-gap: {{ section.settings.gap }}px;"
>
  <div class="aslam-shop-by-category__inner">
    {% if section.settings.show_title and section.settings.title != blank %}
      <header class="aslam-shop-by-category__header">
        <h2 class="aslam-shop-by-category__title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
      </header>
    {% endif %}

    {% if category_count > 0 %}
      <div class="aslam-shop-by-category__carousel" role="region" aria-label="{{ carousel_label | escape }}">
        {% if section.settings.show_desktop_arrows %}
          <button class="aslam-shop-by-category__arrow aslam-shop-by-category__arrow--previous" type="button" data-category-previous aria-label="Previous categories" aria-controls="AslamShopByCategoryTrack-{{ section.id }}">
            <span aria-hidden="true">←</span>
          </button>
        {% endif %}

        <ul id="AslamShopByCategoryTrack-{{ section.id }}" class="aslam-shop-by-category__track" data-category-track data-category-alignment="{{ section.settings.category_alignment }}" tabindex="0" aria-label="{{ carousel_label | escape }}">
          {% for block in section.blocks %}
            {% liquid
              assign category_image = block.settings.image
              assign category_link = block.settings.custom_url
              assign category_name = block.settings.custom_label

              if category_image == blank and block.settings.collection != blank
                assign category_image = block.settings.collection.featured_image
              endif

              if category_link == blank and block.settings.collection != blank
                assign category_link = block.settings.collection.url
              endif

              if category_name == blank and block.settings.collection != blank
                assign category_name = block.settings.collection.title
              endif

              if category_name == blank
                assign category_name = block.settings.category_name
              endif

              if category_name == blank
                assign category_name = 'Category'
              endif

              assign category_image_alt = category_image.alt | default: category_name
              capture category_image_sizes
                echo '(min-width: 750px) '
                echo section.settings.bubble_size
                echo 'px, '
                echo section.settings.mobile_bubble_size
                echo 'px'
              endcapture
            %}

            <li class="aslam-shop-by-category__item" {{ block.shopify_attributes }}>
              {% if category_link != blank %}
                <a class="aslam-shop-by-category__link" href="{{ category_link }}" aria-label="Shop {{ category_name | escape }}">
              {% else %}
                <div class="aslam-shop-by-category__link">
              {% endif %}
                  <div class="aslam-shop-by-category__bubble">
                    {% if category_image != blank %}
                      <img
                        class="aslam-shop-by-category__image"
                        src="{{ category_image | image_url: width: 500 }}"
                        srcset="{{ category_image | image_url: width: 120 }} 120w, {{ category_image | image_url: width: 180 }} 180w, {{ category_image | image_url: width: 240 }} 240w, {{ category_image | image_url: width: 360 }} 360w, {{ category_image | image_url: width: 500 }} 500w"
                        sizes="{{ category_image_sizes | strip }}"
                        width="{{ category_image.width }}"
                        height="{{ category_image.height }}"
                        loading="lazy"
                        alt="{{ category_image_alt | escape }}"
                      >
                    {% else %}
                      <span class="aslam-shop-by-category__icon" aria-hidden="true">
                        {% case block.settings.icon %}
                          {% when 'heart' %}♥
                          {% when 'flower' %}✿
                          {% when 'diamond' %}◆
                          {% when 'star' %}★
                          {% else %}✦
                        {% endcase %}
                      </span>
                    {% endif %}
                  </div>
                  <span class="aslam-shop-by-category__label">{{ category_name | escape }}</span>
              {% if category_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>

        {% if section.settings.show_desktop_arrows %}
          <button class="aslam-shop-by-category__arrow aslam-shop-by-category__arrow--next" type="button" data-category-next aria-label="Next categories" aria-controls="AslamShopByCategoryTrack-{{ section.id }}">
            <span aria-hidden="true">→</span>
          </button>
        {% endif %}

        {% if section.settings.show_mobile_arrows %}
          <div class="aslam-shop-by-category__mobile-controls">
            <button class="aslam-shop-by-category__arrow" type="button" data-category-previous aria-label="Previous categories" aria-controls="AslamShopByCategoryTrack-{{ section.id }}"><span aria-hidden="true">←</span></button>
            <button class="aslam-shop-by-category__arrow" type="button" data-category-next aria-label="Next categories" aria-controls="AslamShopByCategoryTrack-{{ section.id }}"><span aria-hidden="true">→</span></button>
          </div>
        {% endif %}
      </div>
    {% elsif request.design_mode %}
      <p class="aslam-shop-by-category__empty">Add a “Category” block to start building this carousel.</p>
    {% endif %}
  </div>
</section>

<style>
  #AslamShopByCategory-{{ section.id }} { overflow: hidden; background: var(--asbc-background); color: var(--asbc-text); }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__inner { box-sizing: border-box; width: min(100%, 120rem); margin-inline: auto; padding: {{ section.settings.padding_top }}px 3rem {{ section.settings.padding_bottom }}px; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__header { margin-bottom: {{ section.settings.title_spacing }}px; text-align: center; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__title { margin: 0; color: inherit; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__carousel { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(.65rem, 1.5vw, 1.25rem); }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__track { display: flex; gap: var(--asbc-gap); align-items: flex-start; justify-content: flex-start; max-width: 100%; margin: 0; padding: .4rem .15rem .7rem; overflow-x: auto; list-style: none; scroll-behavior: smooth; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__track.is-centered { justify-content: center; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__track::-webkit-scrollbar { display: none; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__item { flex: 0 0 var(--asbc-bubble-size); min-width: 0; scroll-snap-align: start; text-align: center; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__link { display: block; color: inherit; text-decoration: none; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__bubble { display: grid; width: var(--asbc-bubble-size); height: var(--asbc-bubble-size); place-items: center; overflow: hidden; border-radius: {% if section.settings.bubble_shape == 'circle' %}50%{% else %}{{ section.settings.bubble_radius }}px{% endif %}; background: var(--asbc-bubble-background); }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__image { display: block; width: 100%; height: 100%; object-fit: {{ section.settings.image_fit }}; transition: transform .25s ease; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__link:hover .aslam-shop-by-category__image { transform: scale(1.04); }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__icon { font-size: calc(var(--asbc-bubble-size) * .36); line-height: 1; opacity: .8; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__label { display: block; margin-top: .8rem; overflow: hidden; font-size: .95rem; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__arrow { display: grid; width: 2.5rem; height: 2.5rem; flex: none; place-items: center; border: 1px solid currentColor; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; transition: opacity .2s ease; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__arrow:disabled { cursor: not-allowed; opacity: .28; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__mobile-controls { display: none; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__empty { margin: 0; text-align: center; opacity: .7; }
  #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__link:focus-visible, #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__arrow:focus-visible, #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__track:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media screen and (max-width: 989px) { #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__inner { padding: {{ section.settings.tablet_padding_top }}px 2rem {{ section.settings.tablet_padding_bottom }}px; } }
  @media screen and (max-width: 749px) { #AslamShopByCategory-{{ section.id }} { --asbc-bubble-size: {{ section.settings.mobile_bubble_size }}px; --asbc-gap: {{ section.settings.mobile_gap }}px; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__inner { padding: {{ section.settings.mobile_padding_top }}px 1.25rem {{ section.settings.mobile_padding_bottom }}px; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__header { margin-bottom: {{ section.settings.mobile_title_spacing }}px; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__carousel { display: block; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__carousel > .aslam-shop-by-category__arrow { display: none; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__track { padding-right: 1rem; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__label { font-size: .85rem; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__mobile-controls { display: flex; justify-content: center; gap: .65rem; margin-top: .5rem; } }
  @media (prefers-reduced-motion: reduce) { #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__track { scroll-behavior: auto; } #AslamShopByCategory-{{ section.id }} .aslam-shop-by-category__image { transition: none; } }
</style>

<script>
  (() => {
    const section = document.getElementById('AslamShopByCategory-{{ section.id }}');
    if (!section || section.dataset.categoryCarouselReady) return;
    section.dataset.categoryCarouselReady = 'true';

    const track = section.querySelector('[data-category-track]');
    if (!track) return;

    const previousButtons = section.querySelectorAll('[data-category-previous]');
    const nextButtons = section.querySelectorAll('[data-category-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = () => Math.max(track.clientWidth * .8, 180);

    const updateControls = () => {
      const hasOverflow = track.scrollWidth > track.clientWidth + 2;
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      track.classList.toggle('is-centered', track.dataset.categoryAlignment === 'center' && !hasOverflow);

      previousButtons.forEach((button) => {
        button.disabled = !hasOverflow || atStart;
        button.hidden = !hasOverflow;
      });

      nextButtons.forEach((button) => {
        button.disabled = !hasOverflow || atEnd;
        button.hidden = !hasOverflow;
      });
    };

    previousButtons.forEach((button) => button.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: reduceMotion ? 'auto' : 'smooth' })));
    nextButtons.forEach((button) => button.addEventListener('click', () => track.scrollBy({ left: step(), behavior: reduceMotion ? 'auto' : 'smooth' })));

    track.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      track.scrollBy({ left: event.key === 'ArrowLeft' ? -step() : step(), behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    track.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(updateControls).observe(track);
    updateControls();
  })();
</script>

{% schema %}
{
  "name": "Aslam shop by category",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_title", "label": "Show heading", "default": true },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h2", "options": [{ "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" }] },
    { "type": "range", "id": "title_spacing", "label": "Heading bottom spacing", "min": 8, "max": 64, "step": 2, "default": 28, "unit": "px" },
    { "type": "range", "id": "mobile_title_spacing", "label": "Mobile heading bottom spacing", "min": 8, "max": 48, "step": 2, "default": 20, "unit": "px" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1b1b1b" },
    { "type": "color", "id": "bubble_background", "label": "Bubble background", "default": "#f6f6f6" },
    { "type": "select", "id": "bubble_shape", "label": "Bubble shape", "default": "circle", "options": [{ "value": "circle", "label": "Circle" }, { "value": "rounded", "label": "Softly rounded" }] },
    { "type": "range", "id": "bubble_radius", "label": "Rounded corner radius", "min": 4, "max": 50, "step": 2, "default": 20, "unit": "px" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover", "options": [{ "value": "cover", "label": "Fill bubble" }, { "value": "contain", "label": "Show whole image" }] },
    { "type": "header", "content": "Carousel" },
    { "type": "text", "id": "carousel_label", "label": "Accessible carousel label", "default": "Shop by category" },
    { "type": "range", "id": "bubble_size", "label": "Desktop bubble size", "min": 72, "max": 220, "step": 4, "default": 132, "unit": "px" },
    { "type": "range", "id": "mobile_bubble_size", "label": "Mobile bubble size", "min": 56, "max": 160, "step": 4, "default": 92, "unit": "px" },
    { "type": "range", "id": "gap", "label": "Desktop category gap", "min": 8, "max": 64, "step": 2, "default": 24, "unit": "px" },
    { "type": "range", "id": "mobile_gap", "label": "Mobile category gap", "min": 8, "max": 40, "step": 2, "default": 16, "unit": "px" },
    { "type": "select", "id": "category_alignment", "label": "Category alignment", "default": "center", "options": [{ "value": "center", "label": "Center when all categories fit" }, { "value": "flex-start", "label": "Left" }] },
    { "type": "checkbox", "id": "show_desktop_arrows", "label": "Show desktop arrows", "default": true },
    { "type": "checkbox", "id": "show_mobile_arrows", "label": "Show mobile arrows", "default": false },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Desktop top padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Desktop bottom padding", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "tablet_padding_top", "label": "Tablet top padding", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "tablet_padding_bottom", "label": "Tablet bottom padding", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 80, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 80, "step": 4, "default": 32, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "category_name", "label": "Category name" },
        { "type": "text", "id": "custom_label", "label": "Custom label", "info": "Overrides the collection title and category name." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "custom_url", "label": "Custom URL", "info": "Overrides the selected collection URL." },
        { "type": "image_picker", "id": "image", "label": "Category image", "info": "Overrides the collection image." },
        { "type": "select", "id": "icon", "label": "Fallback icon", "default": "sparkle", "info": "Shown only when no image is selected.", "options": [{ "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "flower", "label": "Flower" }, { "value": "diamond", "label": "Diamond" }, { "value": "star", "label": "Star" }] }
      ]
    }
  ],
  "presets": [{ "name": "Aslam shop by category" }]
}
{% endschema %}
